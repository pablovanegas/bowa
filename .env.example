# ── WhatsApp Cloud API (Meta) ─────────────────────────────
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Token que tú inventas y registras en Meta para verificar el webhook
WHATSAPP_VERIFY_TOKEN=
# "App secret" de la app de Meta: valida la firma X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# ── Cifrado ──────────────────────────────────────────────
# Genera una con: npm run cli -- keygen
BOWA_ENCRYPTION_KEY=

# ── Radicados ────────────────────────────────────────────
BOWA_RADICADO_PREFIX=BOWA

# ── Envíos ───────────────────────────────────────────────
BOWA_DEFAULT_COUNTRY_CODE=57
BOWA_RATE_PER_SECOND=10
BOWA_TIMEZONE=America/Bogota
BOWA_STORE_PATH=data/bowa.store
PORT=3000
